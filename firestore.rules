rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function ownsUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validOrderItem(item) {
      let product = get(/databases/$(database)/documents/products/$(item.productId)).data;
      let expectedPrice = (product.discountPrice is number
        && product.discountPrice >= 0
        && product.discountPrice < product.price)
        ? product.discountPrice
        : product.price;
      return item is map
        && item.keys().hasAll(['productId', 'name', 'price'])
        && item.keys().hasOnly(['productId', 'name', 'price'])
        && item.productId is string
        && item.name is string
        && item.price is number
        && product.status == 'active'
        && product.isFree != true
        && item.name == product.name
        && item.price == expectedPrice;
    }

    function validCouponDiscount() {
      let coupon = request.resource.data.coupon;
      return coupon == ''
        ? request.resource.data.discount == 0
        : exists(/databases/$(database)/documents/couponClaims/$(coupon))
          && get(/databases/$(database)/documents/couponClaims/$(coupon)).data.active == true
          && (
            (get(/databases/$(database)/documents/couponClaims/$(coupon)).data.type == 'percent'
              && get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value is number
              && get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value >= 0
              && get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value <= 100
              && request.resource.data.discount == math.round(request.resource.data.subtotal * get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value / 100))
            ||
            (get(/databases/$(database)/documents/couponClaims/$(coupon)).data.type == 'fixed'
              && get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value is number
              && get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value >= 0
              && request.resource.data.discount == (get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value > request.resource.data.subtotal
                ? request.resource.data.subtotal
                : get(/databases/$(database)/documents/couponClaims/$(coupon)).data.value))
          );
    }

    function freeProduct(productId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.isFree == true
        && get(/databases/$(database)/documents/products/$(productId)).data.status == 'active';
    }

    function activePurchaseFor(productId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + productId))
        && get(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + productId)).data.accessStatus == 'active';
    }

    match /users/{userId} {
      allow read: if ownsUser(userId) || isAdmin();

      allow create: if isAdmin()
        || (ownsUser(userId)
          && request.resource.data.keys().hasAll(['id', 'name', 'email', 'role', 'createdAt'])
          && request.resource.data.role == 'customer'
          && request.resource.data.id == userId
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.createdAt is string);

      allow update: if isAdmin()
        || (ownsUser(userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'authProvider', 'createdAt']));

      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productImages/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productAccess/{productId} {
      allow read: if isAdmin() || freeProduct(productId) || activePurchaseFor(productId);
      allow write: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['productId', 'userId', 'purchaseId', 'name', 'rating', 'text', 'date', 'verified', 'createdAt'])
        && request.resource.data.keys().hasOnly(['productId', 'userId', 'purchaseId', 'name', 'rating', 'text', 'date', 'verified', 'moderationStatus', 'createdAt', 'id'])
        && reviewId == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.id == reviewId
        && request.resource.data.productId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.purchaseId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.date is string
        && request.resource.data.verified == false
        && request.resource.data.moderationStatus == 'pending'
        && request.resource.data.createdAt is number
        && activePurchaseFor(request.resource.data.productId);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'moderationStatus'])
        && request.resource.data.verified == (request.resource.data.moderationStatus == 'approved')
        && request.resource.data.moderationStatus in ['approved', 'rejected'];
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'userId', 'items', 'subtotal', 'discount', 'total', 'coupon', 'paymentMethod', 'paymentStatus', 'orderStatus', 'trxId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'userId', 'items', 'subtotal', 'discount', 'total', 'coupon', 'paymentMethod', 'paymentStatus', 'orderStatus', 'trxId', 'createdAt'])
        && request.resource.data.id == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 10
        && (request.resource.data.coupon == '' || request.resource.data.items.size() <= 9)
        && validOrderItem(request.resource.data.items[0])
        && (request.resource.data.items.size() <= 1 || validOrderItem(request.resource.data.items[1]))
        && (request.resource.data.items.size() <= 2 || validOrderItem(request.resource.data.items[2]))
        && (request.resource.data.items.size() <= 3 || validOrderItem(request.resource.data.items[3]))
        && (request.resource.data.items.size() <= 4 || validOrderItem(request.resource.data.items[4]))
        && (request.resource.data.items.size() <= 5 || validOrderItem(request.resource.data.items[5]))
        && (request.resource.data.items.size() <= 6 || validOrderItem(request.resource.data.items[6]))
        && (request.resource.data.items.size() <= 7 || validOrderItem(request.resource.data.items[7]))
        && (request.resource.data.items.size() <= 8 || validOrderItem(request.resource.data.items[8]))
        && (request.resource.data.items.size() <= 9 || validOrderItem(request.resource.data.items[9]))
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && validCouponDiscount()
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.subtotal - request.resource.data.discount
        && request.resource.data.coupon is string
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.orderStatus == 'Awaiting Verification'
        && request.resource.data.trxId is string
        && request.resource.data.trxId.size() > 0
        && request.resource.data.trxId.size() <= 120
        && request.resource.data.createdAt is string;

      allow update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /transactionClaims/{claimId} {
      // A signed-in customer may check only a specific claim ID. Listing
      // transaction claims remains admin-only, so customers cannot enumerate
      // other customers' transaction records.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() > 0
        && request.resource.data.transactionId.size() <= 120
        && claimId == request.resource.data.transactionId
        && request.resource.data.orderId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt is string;
      allow update, delete: if isAdmin();
    }

    match /couponClaims/{couponId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'orderId', 'userId', 'amount', 'transactionId', 'method', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'orderId', 'userId', 'amount', 'transactionId', 'method', 'status', 'createdAt'])
        && request.resource.data.id == paymentId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() > 0
        && request.resource.data.method is string
        && request.resource.data.status == 'Pending'
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.total == request.resource.data.amount
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.trxId == request.resource.data.transactionId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentMethod == request.resource.data.method
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentStatus == 'Pending'
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderStatus == 'Awaiting Verification';

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
